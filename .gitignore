*.tsbuildinfo

# The compiled menu bar binary, the iconset, and any assembled bundle.
# AppIcon.icns IS tracked on purpose: make-icon.py needs Pillow, and a clean
# checkout has to build without it. build-app.sh only regenerates the icon when
# the .icns is missing, so tracking it is what keeps the clean build working.
menubar/StarlinkBar
menubar/icon.iconset/
*.app

